# -----------------------------------------------------------------------------
# Projeto Oficina Admin / Message System
# Estrutura esperada:
# .gitignore
# backend/
# frontend/
# docs/
# docker-compose.yml
# -----------------------------------------------------------------------------

# Ambiente local / variaveis sensiveis
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/

# Ambientes virtuais Python
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/

# Banco local / SQLite
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
backend/db.sqlite3
backend/db.sqlite3-journal
backend/db.sqlite3-shm
backend/db.sqlite3-wal

# Arquivos gerados pelo Django
backend/staticfiles/
backend/static/
backend/media/
!backend/media/.gitkeep

# Logs
*.log
logs/
backend/logs/
frontend/logs/
celerybeat-schedule
celerybeat.pid
*.pid

# Node / React / Vite
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache e artefatos de ferramentas frontend
.eslintcache
.stylelintcache
parcel-cache/
.next/
.nuxt/
.svelte-kit/

# Docker / containers locais
.docker-data/
docker-data/
postgres_data/
redis_data/
media_data/
*.tar
*.tar.gz

# Uploads, backups e exportacoes locais
uploads/
exports/
backups/
backup/
*.bak
*.backup
*.dump
*.sql
*.zip
*.7z
*.rar

# IDEs e editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.sublime-workspace
*.sublime-project

# Sistema operacional
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Certificados/chaves locais
*.pem
*.key
*.crt
*.p12
*.pfx

# Relatorios temporarios
coverage/
reports/tmp/
tmp/
temp/

*.zip