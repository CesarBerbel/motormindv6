# MotorMind v6 - exemplo geral de ambiente
# Para Docker, prefira copiar .env.docker.example para .env.

DEBUG=True
SECRET_KEY=dev-only-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=postgres
DATABASE_URL=postgres://motormind:motormind_dev@postgres:5432/motormindv6
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# URL pública do frontend usada nos links enviados por e-mail.
# Local Vite: http://localhost:5173
# Docker local: http://localhost:8080
# Produção: https://app.seudominio.com
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

JWT_AUTH_COOKIE_ACCESS=oficina_access_token
JWT_AUTH_COOKIE_REFRESH=oficina_refresh_token
JWT_AUTH_COOKIE_DOMAIN=
JWT_AUTH_COOKIE_SAMESITE=Lax
JWT_AUTH_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com

TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO
CREDENTIAL_ENCRYPTION_KEY=
